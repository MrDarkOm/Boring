# /etc/systemd/system/vibematch.service
# sudo systemctl daemon-reload && sudo systemctl enable --now vibematch
[Unit]
Description=VibeMatch web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/boring/vibematch
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
ExecStart=/usr/bin/node server/proxy.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
