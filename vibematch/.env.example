# Скопируй этот файл в .env и вставь свои ключи.
# Ключи читаются ТОЛЬКО прокси-сервером (server/proxy.mjs) и не попадает в браузер.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Порт и адрес сервера (по умолчанию 127.0.0.1:8787 — за nginx/Caddy).
# В Docker задаётся HOST=0.0.0.0. Многие хостинги сами передают PORT.
PROXY_PORT=8787
# HOST=127.0.0.1

# Модель для AI-подсказок и лимит подсказок в час на один IP
# AI_MODEL=claude-sonnet-5-5
# AI_LIMIT_PER_HOUR=20

# Фильмы — TMDB (бесплатно): https://www.themoviedb.org/settings/api
# Подходит и API Key (v3), и API Read Access Token (v4). Без ключа фильмы
# берутся из встроенной подборки.
TMDB_API_KEY=

# Книги на русском — Google Books (необязательно):
# https://console.cloud.google.com/apis/library/books.googleapis.com
# Без ключа книги берутся из Open Library.
GOOGLE_BOOKS_API_KEY=
